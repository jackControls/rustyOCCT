puts "Derived case, not an original OCCT test: cone structure counts"
puts "Written for rusty-occt; see rust/UPSTREAM_TESTS.md (derived cases)."

# OCCT's cone has a seam edge from the base circle's seam vertex and, at an
# apex, a degenerated edge; the kernel's seamless cone, whose apex is a
# vertex loop, reports these counts through its count synthesizer.
pcone c 2 0 3
checkshape c
checknbshapes c -solid 1 -shell 1 -face 2 -wire 2 -edge 3 -vertex 2

# Volume 4 pi and area 4 pi + 2 pi sqrt(13). OCCT's lprops sums edge lengths
# per face use: the circle twice, the seam twice, the degenerated edge none.
checkprops c -v 12.566370614359173 -s 35.220717412637128 -deps 1e-5
checkprops c -l 32.343843779646324 -deps 1e-5

# A frustum: two discs, three wires.
pcone f 2 1 3
checkshape f
checknbshapes f -solid 1 -shell 1 -face 3 -wire 3 -edge 3 -vertex 2
checkprops f -v 21.991148575128553 -s 45.51172806533727 -deps 1e-5
checkprops f -l 44.023667163414278 -deps 1e-5

# The apex at the base.
pcone b 0 1.5 2
checkshape b
checknbshapes b -solid 1 -shell 1 -face 2 -wire 2 -edge 3 -vertex 2
checkprops b -v 4.7123889803846899 -s 18.849555921538759 -deps 1e-5
checkprops b -l 23.849555921538759 -deps 1e-5
