puts "Derived case, not an original OCCT test: torus structure counts"
puts "Written for rusty-occt; see rust/UPSTREAM_TESTS.md (derived cases)."

# OCCT's whole torus is one vertex and two seams, the meridian and the
# latitude circles, in one wire; the kernel's whole torus is one face
# without loops, and its count synthesizer reports OCCT's structure.
ptorus t 3 1
checkshape t
checknbshapes t -solid 1 -shell 1 -face 1 -wire 1 -edge 2 -vertex 1

# Volume 2 pi^2 R r^2 and area 4 pi^2 R r. OCCT's lprops sums edge lengths
# per face use: each seam twice, 2 (2 pi r) + 2 (2 pi (R + r)).
checkprops t -v 59.217626406536152 -s 118.4352528130723 -deps 1e-5
checkprops t -l 62.831853071795865 -deps 1e-5

# A quarter wedge: its face wound in v, closed by a seam in v (a latitude
# arc) between the end circles, which bound discs.
ptorus w 3 1 90
checkshape w
checknbshapes w -solid 1 -shell 1 -face 3 -wire 3 -edge 3 -vertex 2
checkprops w -v 14.804406601634038 -s 35.891998510447662 -deps 1e-5
checkprops w -l 37.699111843077519 -deps 1e-5

# The outer half: a band wound in u between two discs.
ptorus h 3 1 -90 90
checkshape h
checknbshapes h -solid 1 -shell 1 -face 3 -wire 3 -edge 3 -vertex 2
checkprops h -v 90.346271172670745 -s 128.3326647855116 -deps 1e-5
checkprops h -l 81.681408993334624 -deps 1e-5
