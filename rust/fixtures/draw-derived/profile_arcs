puts "Derived case, not an original OCCT test: prisms of profiles with arcs"
puts "Written for rusty-occt; see rust/UPSTREAM_TESTS.md (derived cases)."

# A stadium: two lines and two half circles tangent to them (S5).
profile s F 0 -1 X 3 C 1 180 X -3 C 1 180
prism ps s 0 0 2 c
checkshape ps
checknbshapes ps -solid 1 -shell 1 -face 6 -wire 6 -edge 12 -vertex 8
# Volume 2 (6 + pi), area 2 (6 + pi) + 2 (6 + 2 pi).
checkprops ps -v 18.283185307179586 -s 42.849555921538759 -deps 1e-5

# A rectangle with four quarter-circle fillets.
profile r F 1 0 X 6 C 1 90 Y 4 C 1 90 X -6 C 1 90 Y -4 C 1 90
prism pr r 0 0 3 c
checkshape pr
checknbshapes pr -solid 1 -shell 1 -face 10 -wire 10 -edge 24 -vertex 16
# Volume 3 (44 + pi).
checkprops pr -v 141.42477796076938 -deps 1e-5

# A concave half-circle notch: an arc turning clockwise (negative radius).
profile n F 0 0 X 10 Y 6 XX 6 R 90 C -1 180 XX 0
prism pn n 0 0 1.5 c
checkshape pn
checknbshapes pn -solid 1 -shell 1 -face 8 -wire 8 -edge 18 -vertex 12
# Volume 1.5 (60 - pi / 2).
checkprops pn -v 87.643805509807656 -deps 1e-5
